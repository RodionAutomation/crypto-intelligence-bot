        "jsCode": "const data = $input.first().json;\n\nconst btc = data.bitcoin ?? {};\nconst eth = data.ethereum ?? {};\nconst sol = data.solana ?? {};\n\nfunction line(name, data) {\n    const price = Number(data.usd ?? 0);\n    const change = Number(data.usd_24h_change ?? 0);\n\n    const emoji = change >= 0 ? \"🟢\" : \"🔴\";\n    const sign = change >= 0 ? \"+\" : \"\";\n\n    return `${emoji} *${name}*\n\n💵 Price: *$${price.toLocaleString()}*\n📊 24h: *${sign}${change.toFixed(2)}%*\n\n`;\n}\n\nlet message = `☀️ *CRYPTO MORNING DIGEST*\n\nGood morning! 👋\n\nHere's the latest crypto market snapshot.\n\n━━━━━━━━━━━━━━━\n\n`;\n\nmessage += line(\"BTC\", btc);\nmessage += line(\"ETH\", eth);\nmessage += line(\"SOL\", sol);\n\nmessage += `━━━━━━━━━━━━━━━\n\n📈 Trade smart and have a great day! 🚀`;\n\nreturn [\n  {\n    json: {\n      messageText: message,\n    },\n  },\n];"
      },
