      "id": "53506dbe-46dd-41b0-958b-b91124321994",
      "name": "Get Prices",
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const alerts = $('Get Alerts').all();\n\nconst prices = $('Get Prices').first().json;\n\nconst coinMap = {\n    btc: \"bitcoin\",\n    eth: \"ethereum\",\n    sol: \"solana\"\n};\n\nconst triggered = [];\n\nfor (const item of alerts) {\n\n    const alert = item.json;\n\n    const coin = coinMap[alert.coin?.toLowerCase()];\n\n    if (!coin) continue;\n\n    const currentPrice = Number(prices[coin].usd);\n    const targetPrice = Number(alert.target_price);\n\n    let fire = false;\n\n    switch (alert.operator) {\n\n        case \">\":\n            fire = currentPrice > targetPrice;\n            break;\n\n        case \"<\":\n            fire = currentPrice < targetPrice;\n            break;\n\n        case \">=\":\n            fire = currentPrice >= targetPrice;\n            break;\n\n        case \"<=\":\n            fire = currentPrice <= targetPrice;\n            break;\n\n        case \"=\":\n        case \"==\":\n            fire = currentPrice === targetPrice;\n            break;\n    }\n\n    if (fire) {\n\n        triggered.push({\n            json: {\n\n                alert_id: alert.alert_id,\n\n                user_id: alert.user_id,\n\n                coin: alert.coin,\n\n                operator: alert.operator,\n\n                target_price: targetPrice,\n\n                current_price: currentPrice,\n\n                created_at: alert.created_at,\n\n                row_number: alert.row_number\n            }\n        });\n\n    }\n\n}\n\nreturn triggered;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
