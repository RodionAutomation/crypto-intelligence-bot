    {
      "parameters": {
        "jsCode": "const execution = $json.execution ?? {};\nconst error = execution.error ?? {};\nconst workflow = $json.workflow ?? {};\n\nconst ignoredPatterns = [\n  \"blocked by the user\",\n  \"chat not found\",\n  \"user is deactivated\"\n];\n\nconst searchableText = [\n  error.message,\n  error.description,\n  ...(error.messages ?? [])\n]\n.filter(Boolean)\n.join(\" \")\n.toLowerCase();\n\nconst ignored = ignoredPatterns.some(pattern =>\n  searchableText.includes(pattern.toLowerCase())\n);\n\nreturn [\n{\njson:{\n\ntimestamp: new Date().toLocaleString('uk-UA', {\n    timeZone: 'Europe/Kyiv'\n}),\n\nworkflow: workflow.name ?? \"Unknown\",\n\nnode:\nerror.node?.name ??\nexecution.lastNodeExecuted ??\n\"Unknown\",\n\nlevel: error.level ?? \"error\",\n\ntype: error.name ?? \"Unknown\",\n\nhttp_code: error.httpCode ?? \"-\",\n\ndescription:\nerror.description ??\n\"-\",\n\nmessage:\nerror.message ??\n\"Unknown error\",\n\nexecution_id:\nexecution.id ?? \"-\",\n\nexecution_url:\nexecution.url ?? \"-\",\n\nignored\n\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
